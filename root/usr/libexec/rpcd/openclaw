}

# ---- openclaw.backup -------------------------------------------------------
# action: create|verify|restore|list|delete
m_backup() {
	local action="" only_config="" file=""
	json_get_var action "action"
	json_get_var only_config "only_config"
	json_get_var file "file"
	[ -n "$action" ] || action="create"

	local install_path="$oc_root"
	local node_bin="$oc_node_bin"
	local oc_entry=""
	oc_entry=$(find_oc_entry) || {
		json_init
		json_add_string "status" "error"
		json_add_string "message" "OpenClaw 未安装，无法执行备份操作"
		json_dump
		return 0
	}

	local backup_dir="${oc_data}/.openclaw/backups"

	# parse a single backup tarball: prints "filename|time|size_str|type|path"
	parse_backup_info() {
		local filepath="$1" filename="" size=0 ts="" btype="unknown" manifest="" size_str=""
		filename=$(printf '%s' "$filepath" | sed 's:.*/::')
		size=$(stat -c %s "$filepath" 2>/dev/null || printf '0')
		case "$size" in ''|*[!0-9]*) size=0 ;; esac
		# 2026-03-11T18-28-43.149Z-openclaw-backup.tar.gz → 2026-03-11 18:28:43
		ts=$(printf '%s' "$filename" | sed -n 's/^\([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]\.[0-9]*Z\).*/\1/p')
		local display_time=""
		if [ -n "$ts" ]; then
			display_time=$(printf '%s' "$ts" | awk '{ split($0, a, "T"); split(a[2], b, "[.-]"); printf "%s %s:%s:%s", a[1], b[1], b[2], b[3] }')
		fi
		manifest=$(tar --wildcards -xzf "$filepath" '*/manifest.json' -O 2>/dev/null)
		if [ -n "$manifest" ]; then
			if printf '%s' "$manifest" | grep -q '"onlyConfig"[[:space:]]*:[[:space:]]*true'; then
				btype="config"
			elif printf '%s' "$manifest" | grep -q '"onlyConfig"[[:space:]]*:[[:space:]]*false'; then
				btype="full"
			fi
		else
			if [ "$size" -lt 50000 ] 2>/dev/null; then
				btype="config"
			else
				btype="full"
			fi
		fi
		size_str=$(format_size "$size")
		echo "$filename|$display_time|$size_str|$btype|$filepath"
	}

	case "$action" in
		create)
			[ "$only_config" = "1" ] || only_config="1"
			mkdir -p "$backup_dir"
			local out backup_path
			if [ "$only_config" = "1" ]; then
				out=$(cd "$backup_dir" && HOME="$oc_data" OPENCLAW_HOME="$oc_data" \
					OPENCLAW_STATE_DIR="${oc_data}/.openclaw" OPENCLAW_CONFIG_PATH="$oc_config_file" \
					PATH="${oc_node_base}/bin:${oc_global}/bin:$PATH" \
					"$node_bin" "$oc_entry" backup create --only-config --no-include-workspace 2>&1)
			else
				out=$(cd "$backup_dir" && HOME="$oc_data" OPENCLAW_HOME="$oc_data" \
					OPENCLAW_STATE_DIR="${oc_data}/.openclaw" OPENCLAW_CONFIG_PATH="$oc_config_file" \
					PATH="${oc_node_base}/bin:${oc_global}/bin:$PATH" \
					"$node_bin" "$oc_entry" backup create --no-include-workspace 2>&1)
			fi
			# full backups may land in HOME — move into backup_dir
			mv "${oc_data}"/*-openclaw-backup.tar.gz "$backup_dir"/ 2>/dev/null
			backup_path=$(printf '%s' "$out" | grep -o '[^[:space:]]*\.tar\.gz' | head -n 1)
			json_init
			json_add_string "status" "ok"
			json_add_string "action" "create"
			json_add_string "output" "$out"
			json_add_string "backup_path" "$backup_path"
			json_dump
			;;
		verify)
			local latest=""
			latest=$(ls -t "$backup_dir"/*-openclaw-backup.tar.gz 2>/dev/null | head -1 | tr -d '[:space:]')
			if [ -z "$latest" ]; then
				json_init
				json_add_string "status" "error"
				json_add_string "message" "未找到备份文件，请先创建备份"
				json_dump
				return 0
			fi
			local output=""
			output=$(HOME="$oc_data" OPENCLAW_HOME="$oc_data" \
				OPENCLAW_STATE_DIR="${oc_data}/.openclaw" OPENCLAW_CONFIG_PATH="$oc_config_file" \
				PATH="${oc_node_base}/bin:${oc_global}/bin:$PATH" \
				"$node_bin" "$oc_entry" backup verify "$latest" 2>&1)
			json_init
			json_add_string "status" "ok"
			json_add_string "action" "verify"
			json_add_string "output" "$output"
			json_add_string "backup_path" "$latest"
			json_dump
			;;
		restore)
			local target_file="$file" restore_path=""
			if [ -n "$target_file" ]; then
				target_file=$(printf '%s' "$target_file" | sed 's:.*/::')
				case "$target_file" in
					*-openclaw-backup.tar.gz) restore_path="${backup_dir}/${target_file}" ;;
				esac
			fi
			if [ -z "$restore_path" ] || [ ! -f "$restore_path" ]; then
				restore_path=$(ls -t "$backup_dir"/*-openclaw-backup.tar.gz 2>/dev/null | head -1 | tr -d '[:space:]')
			fi
			if [ -z "$restore_path" ]; then
				json_init
				json_add_string "status" "error"
				json_add_string "message" "未找到备份文件，请先创建备份"
				json_dump
				return 0
			fi
			local state_dir="${oc_data}/.openclaw"
			local config_path="${state_dir}/openclaw.json"

			# 1) validate openclaw.json inside the backup first
			local json_content="" check=""
			json_content=$(tar -xzf "$restore_path" --wildcards '*/openclaw.json' -O 2>/dev/null)
			if [ -z "$json_content" ]; then
				json_init
				json_add_string "status" "error"
				json_add_string "message" "备份文件中未找到 openclaw.json"
				json_dump
				return 0
			fi
			local tmpfile="/tmp/oc-restore-check.json"
			printf '%s' "$json_content" > "$tmpfile"
			if [ -x "$node_bin" ]; then
				check=$("$node_bin" -e "try{JSON.parse(require('fs').readFileSync('$tmpfile','utf8'));console.log('OK')}catch(e){console.log('FAIL')}" 2>/dev/null | tr -d '[:space:]')
			else
				check="FAIL"
			fi
			rm -f "$tmpfile"
			if [ "$check" != "OK" ]; then
				json_init
				json_add_string "status" "error"
				json_add_string "message" "备份文件中的配置无效，恢复已取消"
				json_dump
				return 0
			fi

			# 2) back up current config
			cp -f "$config_path" "${config_path}.pre-restore" 2>/dev/null

			# 3) figure out the payload prefix (backup layout: <name>/payload/posix/<abspath>)
			local first_entry="" backup_name="" payload_prefix="" strip_count=3
			first_entry=$(tar -tzf "$restore_path" 2>/dev/null | head -1 | tr -d '[:space:]')
			backup_name=$(printf '%s' "$first_entry" | sed -n 's/^\([^/]*\)\/.*/\1/p')
			if [ -z "$backup_name" ]; then
				json_init
				json_add_string "status" "error"
				json_add_string "message" "备份文件格式无法识别"
				json_dump
				return 0
			fi
			payload_prefix="${backup_name}/payload/posix/"

			# 4) stop the service and wait for the port to be released
			/etc/init.d/openclaw stop >/dev/null 2>&1
			sleep 2

			# 5) extract payload files to the root filesystem (original absolute paths)
			local extract_out=""
			extract_out=$(tar -xzf "$restore_path" --strip-components=$strip_count -C / "$payload_prefix" 2>&1)

			# 6) repair state permissions
			fix_state_permissions "$state_dir"

			# 7) restart the service
			/etc/init.d/openclaw start >/dev/null 2>&1 &

			json_init
			json_add_string "status" "ok"
			json_add_string "action" "restore"
			json_add_string "message" "已从备份完整恢复所有配置和数据，服务正在重启。原配置已保存为 openclaw.json.pre-restore"
			json_add_string "backup_path" "$restore_path"
			json_add_string "extract_output" "$extract_out"
			json_dump
			;;
		list)
			# newest 20 backups with type/size/time
			local files f info count=0
			json_init
			json_add_string "status" "ok"
			json_add_string "action" "list"
			json_add_array "backups"
			files=$(ls -t "$backup_dir"/*-openclaw-backup.tar.gz 2>/dev/null)
			if [ -n "$files" ]; then
				local old_ifs="$IFS"; IFS='
'
				for f in $files; do
					[ -n "$f" ] || continue
					count=$((count + 1))
					[ "$count" -gt 20 ] && break
					info=$(parse_backup_info "$f")
					# filename|time|size_str|type|filepath
					json_add_object ""
					json_add_string "filename" "$(printf '%s' "$info" | cut -d'|' -f1)"
					json_add_string "time" "$(printf '%s' "$info" | cut -d'|' -f2)"
					json_add_string "size_str" "$(printf '%s' "$info" | cut -d'|' -f3)"
					json_add_string "backup_type" "$(printf '%s' "$info" | cut -d'|' -f4)"
					json_add_string "filepath" "$(printf '%s' "$info" | cut -d'|' -f5)"
					json_close_object
				done
				IFS="$old_ifs"
			fi
			json_close_array
			json_dump
			;;
		delete)
			local target_file="$file" del_path=""
			target_file=$(printf '%s' "$target_file" | sed 's:.*/::')
			case "$target_file" in
				*-openclaw-backup.tar.gz) del_path="${backup_dir}/${target_file}" ;;
			esac
			if [ -z "$del_path" ]; then
				json_init
				json_add_string "status" "error"
				json_add_string "message" "无效的备份文件名"
				json_dump
				return 0
			fi
			if [ ! -f "$del_path" ]; then
				json_init
				json_add_string "status" "error"
				json_add_string "message" "备份文件不存在"
				json_dump
				return 0
			fi
			rm -f "$del_path"
			json_init
			json_add_string "status" "ok"
			json_add_string "action" "delete"
			json_add_string "message" "已删除备份: $target_file"
			json_dump
			;;
		*)
			json_init
			json_add_string "status" "error"
			json_add_string "message" "未知备份操作: $action"
			json_dump
			;;
	esac
}

# ---- openclaw.check_system (pre-install detection) ------------------------
m_check_system() {
	local input_path="" normalized=""
	json_get_var input_path "install_path"
	[ -n "$input_path" ] || input_path=$(uci -q get openclaw.main.install_path 2>/dev/null || printf '/opt')
	normalized=$(oc_normalize_install_path "$input_path")

	json_init
	if [ -z "$normalized" ]; then
		json_add_int "memory_mb" 0
		json_add_boolean "memory_ok" 0
		json_add_int "disk_mb" 0
		json_add_boolean "disk_ok" 0
		json_add_string "disk_path" ""
		json_add_string "install_path" "$input_path"
		json_add_boolean "path_valid" 0
		json_add_boolean "writable_ok" 0
		json_add_string "disk_free_str" ""
		json_add_boolean "pass" 0
		json_add_string "message" "安装路径无效：必须是绝对路径，且不能包含空格、引号或 shell 特殊字符。"
		json_dump
		return 0
	fi

	local MIN_MEMORY_MB=1024 MIN_DISK_MB=2048
	local memory_mb=0 memory_ok=0 disk_mb=0 disk_ok=0
	local disk_path="" disk_free_str="" writable_ok=0 pass=0 message=""

	memory_mb=$(awk '/MemTotal:[[:space:]]*[0-9]+ kB/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
	case "$memory_mb" in ''|*[!0-9]*) memory_mb=0 ;; esac
	[ "$memory_mb" -ge "$MIN_MEMORY_MB" ] && memory_ok=1

	# climb up until an existing mount point is found
	local probe="$normalized"
	while [ -n "$probe" ] && [ "$probe" != "/" ] && [ ! -e "$probe" ]; do
		probe=$(printf '%s' "$probe" | sed 's:\(.*\)/[^/]*$:\1:')
		[ -n "$probe" ] || probe="/"
	done
	[ -n "$probe" ] || probe="/"
	disk_path="$probe"

	local dfm="" dfh=""
	dfm=$(df -m "$disk_path" 2>/dev/null | tail -1 | awk '{print $4}' | tr -d '[:space:]')
	case "$dfm" in ''|*[!0-9]*) dfm="" ;; esac
	if [ -n "$dfm" ]; then
		disk_mb=$((dfm + 0))
		disk_free_str=$(df -h "$disk_path" 2>/dev/null | tail -1 | awk '{print $4}' | tr -d '[:space:]')
	else
		dfm=$(df -m / 2>/dev/null | tail -1 | awk '{print $4}' | tr -d '[:space:]')
		case "$dfm" in ''|*[!0-9]*) dfm="" ;; esac
		if [ -n "$dfm" ]; then
			disk_mb=$((dfm + 0))
			disk_path="/"
			disk_free_str=$(df -h / 2>/dev/null | tail -1 | awk '{print $4}' | tr -d '[:space:]')
		fi
	fi
	[ "$disk_mb" -ge "$MIN_DISK_MB" ] && disk_ok=1

	# write probe: create + remove a temp dir on the real mount point
	local probe_dir="${disk_path}/.openclaw-write-test-$$"
	if mkdir "$probe_dir" >/dev/null 2>&1; then
		writable_ok=1
		rmdir "$probe_dir" >/dev/null 2>&1
	fi

	[ "$memory_ok" = "1" ] && [ "$disk_ok" = "1" ] && [ "$writable_ok" = "1" ] && pass=1
	if [ "$pass" = "1" ]; then
		message="系统配置检测通过"
	else
		local issues="" sep=""
		if [ "$memory_ok" != "1" ]; then
			issues="内存不足: 当前 ${memory_mb} MB，需要至少 ${MIN_MEMORY_MB} MB"
			sep="；"
		fi
		if [ "$disk_ok" != "1" ]; then
			issues="${issues}${sep}磁盘空间不足: 当前 ${disk_mb} MB 可用，需要至少 ${MIN_DISK_MB} MB"
			sep="；"
		fi
		if [ "$writable_ok" != "1" ]; then
			issues="${issues}${sep}安装路径所在挂载点不可写，可能是 overlay 已满、只读或外置盘未正确挂载"
		fi
		message="$issues"
	fi

	json_add_int "memory_mb" "$memory_mb"
	json_add_boolean "memory_ok" "$memory_ok"
	json_add_int "disk_mb" "$disk_mb"
	json_add_boolean "disk_ok" "$disk_ok"
	json_add_string "disk_path" "$disk_path"
	json_add_string "install_path" "$normalized"
	json_add_boolean "path_valid" 1
	json_add_boolean "writable_ok" "$writable_ok"
	json_add_string "disk_free_str" "$disk_free_str"
	json_add_boolean "pass" "$pass"
	json_add_string "message" "$message"
	json_dump
}

# ---- openclaw.wechat_status ------------------------------------------------
m_wechat_status() {
	local install_path="$oc_root"
	local plugin_installed=0 logged_in=0 plugin_version=""
	local wechat_dir=""

	if wechat_dir=$(find_wechat_plugin_dir); then
		plugin_installed=1
		if [ -f "${wechat_dir}/package.json" ]; then
			plugin_version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${wechat_dir}/package.json" 2>/dev/null | head -n 1)
		fi
	fi

	# account state: modern per-plugin accounts.json first, legacy openclaw.json layout after.
	local accounts_file="${oc_data}/.openclaw/openclaw-weixin/accounts.json"
	local acc_tokens=""
	if [ -f "$accounts_file" ]; then
		# the former Lua controller enumerated every quoted token; keep the
		# same observable data shape ({name}) and the same login heuristic.
		acc_tokens=$(grep -o '"[^"]*"' "$accounts_file" 2>/dev/null | tr -d '"')
		if [ -n "$acc_tokens" ]; then
			logged_in=1
		fi
	fi

	if [ -f "$oc_config_file" ]; then
		local content=""
		content=$(cat "$oc_config_file" 2>/dev/null)
		if printf '%s' "$content" | grep -q '"openclaw-weixin"[[:space:]]*:[[:space:]]*{'; then
			# legacy layout: accounts array entries carry wxid / nickName …
			local accounts_str=""
			accounts_str=$(printf '%s' "$content" | sed -n 's/.*"accounts"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')
			local legacy_hit=0
			printf '%s' "$accounts_str" | grep -q '"wxid' && legacy_hit=1
			printf '%s' "$accounts_str" | grep -q '"nickName"' && legacy_hit=1
			if [ "$legacy_hit" = "1" ] && [ "$logged_in" != "1" ]; then
				logged_in=1
				acc_tokens="微信账号"
			fi
			if printf '%s' "$content" | grep -q '"credential"[[:space:]]*:[[:space:]]*{' && [ "$logged_in" != "1" ]; then
				logged_in=1
				acc_tokens="微信账号"
			fi
		fi
	fi

	json_init
	json_add_boolean "plugin_installed" "$plugin_installed"
	json_add_boolean "logged_in" "$logged_in"
	json_add_string "install_path" "$install_path"
	[ -n "$plugin_version" ] && json_add_string "plugin_version" "$plugin_version"
	json_add_array "accounts"
	if [ "$logged_in" = "1" ]; then
		local old_ifs="$IFS"; IFS='
'
		for one in $acc_tokens; do
			[ -n "$one" ] || continue
			json_add_object ""
			json_add_string "name" "$one"
			json_close_object
		done
		IFS="$old_ifs"
	fi
	json_close_array
	json_dump
}

# ===========================================================================
#  WeChat plugin lifecycle (install / upgrade / login / logout / uninstall)
#  Commands, log wording and checks are ported 1:1 from the Lua controller so
#  the user-visible behavior stays identical.
# ===========================================================================

# write marker content + exit code files
wechat_write_log_and_exit() {
	local log_file="$1" exit_file="$2" content="$3" code="${4:-1}"
	printf '%s\n' "$content" > "$log_file"
	printf '%s\n' "$code" > "$exit_file"
}

# 微信接口连通性探测 (appends to the given log file)
wechat_network_probe() {
	local log_file="$1" node_bin="$2" body code rc sample
	{
		echo "微信接口连通性检查: https://ilinkai.weixin.qq.com" >> "$log_file"
		if command -v curl >/dev/null 2>&1; then
			body="/tmp/openclaw-wechat-probe-$$.txt"
			code=$(curl -sS -o "$body" -w '%{http_code}' --connect-timeout 8 --max-time 15 -X POST -H 'content-type: application/json' --data '{}' 'https://ilinkai.weixin.qq.com/ilink/bot/getupdates' 2>> "$log_file")
			rc=$?
			if [ "$rc" -eq 0 ]; then
				sample=$(tr '\n\r\t' '   ' < "$body" 2>/dev/null | cut -c1-180)
				echo "微信接口连通性检查: HTTP $code $sample" >> "$log_file"
			else
				echo "微信接口连通性检查失败: curl exit $rc" >> "$log_file"
			fi
			rm -f "$body"
		elif [ -x "$node_bin" ]; then
			local probe_js="/tmp/oc-wechat-probe-$$.js"
			cat > "$probe_js" <<'NJS'
const target = 'https://ilinkai.weixin.qq.com/ilink/bot/getupdates';
const started = Date.now();
const controller = new AbortController();
const timer = setTimeout(() => controller.abort(new Error('timeout')), 10000);
(async () => {
  try {
    const res = await fetch(target, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: '{}',
      signal: controller.signal
    });
    const text = await res.text();
    const sample = text.replace(/\s+/g, ' ').slice(0, 180);
    console.log(`微信接口连通性检查: HTTP ${res.status} ${res.statusText || ''} ${Date.now() - started}ms ${sample}`);
  } catch (e) {
    const code = e && (e.code || (e.cause && e.cause.code) || e.name) || 'ERR';
    const msg = e && e.message ? e.message : String(e);
    console.log(`微信接口连通性检查失败: ${code} ${msg}`);
  } finally {
    clearTimeout(timer);
  }
})();
NJS
			NODE_ICU_DATA="${NODE_ICU_DATA:-${oc_node_base}/share/icu}" "$node_bin" "$probe_js" >> "$log_file" 2>&1 || true
			rm -f "$probe_js"
		else
			echo '⚠️ curl/Node.js 不存在，跳过微信接口连通性检查' >> "$log_file"
		fi
	} 2>/dev/null
}

# python3 bootstrap for the wechat plugin
wechat_python3_bootstrap() {
	local log_file="$1"
	if ! command -v python3 >/dev/null 2>&1; then
		echo '未检测到 python3，正在尝试安装 python3-light...' >> "$log_file"
		( opkg update && opkg install python3-light ) >> "$log_file" 2>&1 || true
	fi
	if ! command -v python3 >/dev/null 2>&1; then
		echo '❌ python3-light 自动安装失败，请手动执行: opkg update && opkg install python3-light' >> "$log_file"
		echo 127 > /tmp/openclaw-wechat-install.exit
		exit 0
	fi
}

# write the "openclaw-weixin enabled + allowed" state into openclaw.json via node
wechat_enable_plugin_config() {
	local node_bin="$1" log_file="$2" exit_file="$3" js
	if [ "$RC" -eq 0 ]; then
		if [ -x "$node_bin" ]; then
			js="/tmp/oc-wechat-enable-$$.js"
			cat > "$js" <<'NJS'
const fs = require('fs');
const path = require('path');
const configPath = process.env.OC_CONFIG;
let d = {};
try { d = JSON.parse(fs.readFileSync(configPath, 'utf8')); } catch (e) { d = {}; }
if (!d.plugins || typeof d.plugins !== 'object') d.plugins = {};
if (!Array.isArray(d.plugins.allow)) d.plugins.allow = [];
if (d.plugins.installs) delete d.plugins.installs['openclaw-weixin'];
if (!d.plugins.allow.includes('openclaw-weixin')) d.plugins.allow.push('openclaw-weixin');
if (!d.channels || typeof d.channels !== 'object') d.channels = {};
if (!d.channels['openclaw-weixin'] || typeof d.channels['openclaw-weixin'] !== 'object') { d.channels['openclaw-weixin'] = {}; }
d.channels['openclaw-weixin'].enabled = true;
fs.mkdirSync(path.dirname(configPath), { recursive: true });
fs.writeFileSync(configPath, JSON.stringify(d, null, 2) + '\n');
NJS
			OC_CONFIG="$oc_config_file" "$node_bin" "$js" >> "$log_file" 2>&1
			REG_RC=$?
			rm -f "$js"
			if [ "$REG_RC" -eq 0 ]; then
				chown openclaw:openclaw "$oc_config_file" 2>/dev/null
				[ -x /usr/libexec/openclaw-permissions.sh ] && /usr/libexec/openclaw-permissions.sh fix-state "${oc_data}/.openclaw" >/dev/null 2>&1
				echo 'Enabled openclaw-weixin channel in OpenClaw config.' >> "$log_file"
			else
				RC=$REG_RC
				echo "$RC" > "$exit_file"
				echo 'Failed to enable openclaw-weixin channel in OpenClaw config.' >> "$log_file"
			fi
		else
			RC=127
			echo "$RC" > "$exit_file"
			echo 'Node.js not found, cannot enable openclaw-weixin channel.' >> "$log_file"
		fi
	fi
}

# official plugin installer through the current OpenClaw CLI (SQLite plugin index)
wechat_openclaw_plugin_install() {
	local log_file="$1" oc_entry="$2"
	{
		echo '使用 OpenClaw 官方插件安装器写入 SQLite 插件索引...' >> "$log_file"
		run_as_openclaw "HOME=$oc_data OPENCLAW_HOME=$oc_data OPENCLAW_STATE_DIR=${oc_data}/.openclaw OPENCLAW_CONFIG_PATH=$oc_config_file OPENCLAW_SUPERVISOR_MODE=external OPENCLAW_SERVICE_REPAIR_POLICY=external NODE_ICU_DATA=${oc_node_base}/share/icu NPM_CONFIG_CACHE=${oc_data}/.npm npm_config_cache=${oc_data}/.npm TMPDIR=${oc_data}/.tmp PATH=${oc_node_base}/bin:${oc_global}/bin:\$PATH $oc_node_bin $oc_entry plugins install --force --pin @tencent-weixin/openclaw-weixin@2.4.8" >> "$log_file" 2>&1
		RC=$?
		echo "$RC" > /tmp/openclaw-wechat-install.exit
		if [ "$RC" -eq 0 ]; then
			echo '✅ OpenClaw 插件索引注册完成' >> "$log_file"
		else
			echo "❌ OpenClaw 插件安装失败 (exit: '$RC')" >> "$log_file"
		fi
	} 2>/dev/null
}

# enable + refresh SQLite registry + runtime verification
wechat_finalize_plugin_registry() {
	local log_file="$1" exit_file="$2" oc_entry="$3"
	if [ "$RC" -eq 0 ]; then
		{
			local cli_env="HOME=$oc_data OPENCLAW_HOME=$oc_data OPENCLAW_STATE_DIR=${oc_data}/.openclaw OPENCLAW_CONFIG_PATH=$oc_config_file OPENCLAW_SUPERVISOR_MODE=external OPENCLAW_SERVICE_REPAIR_POLICY=external NODE_ICU_DATA=${oc_node_base}/share/icu NPM_CONFIG_CACHE=${oc_data}/.npm TMPDIR=${oc_data}/.tmp PATH=${oc_node_base}/bin:${oc_global}/bin:\$PATH"
			echo '正在写入微信插件启用状态...' >> "$log_file"
			run_as_openclaw "$cli_env $oc_node_bin $oc_entry plugins enable openclaw-weixin" >> "$log_file" 2>&1
			FINAL_RC=$?
			if [ "$FINAL_RC" -eq 0 ]; then
				echo '正在刷新 SQLite 插件注册表...' >> "$log_file"
				run_as_openclaw "$cli_env $oc_node_bin $oc_entry plugins registry --refresh --json" >> "$log_file" 2>&1
				FINAL_RC=$?
			fi
			if [ "$FINAL_RC" -eq 0 ]; then
				echo '正在验证微信插件运行时状态 (plugins inspect openclaw-weixin --runtime --json)...' >> "$log_file"
				local inspect="/tmp/openclaw-wechat-inspect-$$.log" verify_js="/tmp/oc-wechat-verify-$$.js"
				run_as_openclaw "$cli_env $oc_node_bin $oc_entry plugins inspect openclaw-weixin --runtime --json" > "$inspect" 2>&1
				VERIFY_RC=$?
				cat "$inspect" >> "$log_file"
				cat > "$verify_js" <<'NJS'
const fs = require('fs');
const raw = fs.readFileSync(process.argv[1], 'utf8');
try {
  const j = JSON.parse(raw);
  const ok = (j && (j.status === 'loaded' || j.loaded === true || j.enabled === true ||
    j.channel === 'openclaw-weixin' ||
    (j.channels && j.channels.includes('openclaw-weixin')) ||
    (j.capabilities && j.capabilities.includes('channel'))));
  process.exit(ok ? 0 : 1);
} catch (e) {
  process.exit(1);
}
NJS
				if [ "$VERIFY_RC" -ne 0 ] || ! "$oc_node_bin" "$verify_js" "$inspect" >/dev/null 2>&1; then
					FINAL_RC=1
				fi
				rm -f "$inspect" "$verify_js"
			fi
			if [ "$FINAL_RC" -eq 0 ]; then
				echo '✅ 微信插件已启用，SQLite 注册表已刷新并通过加载验证' >> "$log_file"
			else
				RC=$FINAL_RC
				echo "$RC" > "$exit_file"
				echo '❌ 微信插件启用或注册表验证失败' >> "$log_file"
			fi
		} 2>/dev/null
	fi
}

# prepare data dirs & permissions for wechat install/upgrade
wechat_prepare_workdirs() {
	if [ -x /usr/libexec/openclaw-permissions.sh ]; then
		/usr/libexec/openclaw-permissions.sh prepare-workdirs "$oc_data" >/dev/null 2>&1
	else
		mkdir -p "${oc_data}/.npm" "${oc_data}/.tmp" "${oc_data}/.openclaw/extensions"
		chown -R openclaw:openclaw "${oc_data}/.npm" "${oc_data}/.tmp" 2>/dev/null
		chown openclaw:openclaw "${oc_data}/.openclaw" 2>/dev/null
		chown -R openclaw:openclaw "${oc_data}/.openclaw/extensions" 2>/dev/null
		chmod -R 755 "${oc_data}/.openclaw/extensions" 2>/dev/null
	fi
}

# shared body of the wechat install/upgrade background job ($1 = oc_entry)
wechat_install_common() {
	local oc_entry="$1" log_file="/tmp/openclaw-wechat-install.log"
	{
		echo "npx 路径: $oc_npx_bin" >> "$log_file"
		echo "Node 版本: $("$oc_node_bin" -v 2>/dev/null || echo 未检测到)" >> "$log_file"
		wechat_network_probe "$log_file" "$oc_node_bin"
		wechat_python3_bootstrap "$log_file"
		wechat_prepare_workdirs
		if [ ! -w "${oc_data}/.npm" ] || [ ! -w "${oc_data}/.tmp" ]; then
			echo '❌ npm cache/tmp 目录不可写' >> "$log_file"
			echo 1 > /tmp/openclaw-wechat-install.exit
			return 1
		fi
		run_as_openclaw "test -w ${oc_data}/.npm && test -w ${oc_data}/.tmp && test -w ${oc_data}/.openclaw" || {
			echo '❌ openclaw 用户无法写入 npm cache/tmp/data 目录' >> "$log_file"
			echo 1 > /tmp/openclaw-wechat-install.exit
			return 1
		}
		RC=0
		wechat_openclaw_plugin_install "$log_file" "$oc_entry"
		wechat_enable_plugin_config "$oc_node_bin" "$log_file" /tmp/openclaw-wechat-install.exit
		wechat_finalize_plugin_registry "$log_file" /tmp/openclaw-wechat-install.exit "$oc_entry"
		# critical: repair extension permissions so the gateway can read the plugin
		[ -x /usr/libexec/openclaw-permissions.sh ] && /usr/libexec/openclaw-permissions.sh fix-state "${oc_data}/.openclaw" >/dev/null 2>&1
		if [ "$RC" -eq 0 ]; then
			if [ "${OC_WECHAT_MODE:-install}" = "upgrade" ]; then
				echo '✅ 微信插件升级成功！' >> "$log_file"
			else
				echo '✅ 微信插件安装成功！' >> "$log_file"
			fi
		else
			if [ "${OC_WECHAT_MODE:-install}" = "upgrade" ]; then
				echo "❌ 升级失败 (exit: '$RC')" >> "$log_file"
			else
				echo "❌ 安装失败 (exit: '$RC')" >> "$log_file"
			fi
		fi
	} 2>/dev/null
}

m_wechat_install() {
	wechat_kickoff_install "install"
}

m_wechat_upgrade_plugin() {
	wechat_kickoff_install "upgrade"
}

wechat_kickoff_install() {
	local mode="$1"
	rm -f /tmp/openclaw-wechat-install.log /tmp/openclaw-wechat-install.pid /tmp/openclaw-wechat-install.exit
	local oc_entry=""
	oc_entry=$(find_oc_entry)
	if [ ! -x "$oc_node_bin" ] || [ -z "$oc_entry" ]; then
		{
			if [ "$mode" = "upgrade" ]; then
				echo "正在升级微信插件..."
			else
				echo "开始安装微信插件..."
			fi
			echo "安装路径: $oc_root"
			echo "❌ 错误: Node.js 或 OpenClaw CLI 不存在。"
			if [ "$mode" = "upgrade" ]; then
				echo "请先检查运行环境是否正常安装。"
			else
				echo "请先在「基本设置」页面安装运行环境。"
			fi
			echo "UCI install_path=$(uci -q get openclaw.main.install_path 2>/dev/null || echo 未设置)"
		} > /tmp/openclaw-wechat-install.log
		echo 127 > /tmp/openclaw-wechat-install.exit
		json_init
		json_add_string "status" "ok"
		json_add_string "message" "微信插件安装已在后台启动..."
		json_dump
		return 0
	fi
	if ! ensure_openclaw_user "$oc_data"; then
		{
			if [ "$mode" = "upgrade" ]; then
				echo "正在升级微信插件..."
			else
				echo "开始安装微信插件..."
			fi
			echo "安装路径: $oc_root"
			echo "❌ 错误: 无法创建或读取 openclaw 系统用户。"
			echo "请检查 /etc/passwd、/etc/group 是否可写。"
		} > /tmp/openclaw-wechat-install.log
		echo 1 > /tmp/openclaw-wechat-install.exit
		json_init
		json_add_string "status" "ok"
		json_add_string "message" "微信插件安装已在后台启动..."
		json_dump
		return 0
	fi

	# launch the background job. Note: never release the gateway port here —
	# stopping a live gateway would trigger procd crash-loop.
	(
		export OC_WECHAT_MODE="$mode"
		if [ "$mode" = "upgrade" ]; then
			echo '正在升级微信插件...' > /tmp/openclaw-wechat-install.log
		else
			echo '开始安装微信插件...' > /tmp/openclaw-wechat-install.log
		fi
		echo "安装路径: $oc_root" >> /tmp/openclaw-wechat-install.log
		wechat_install_common "$oc_entry"
	) >/dev/null 2>&1 &
	echo $! > /tmp/openclaw-wechat-install.pid

	json_init
	json_add_string "status" "ok"
	json_add_string "message" "微信插件安装已在后台启动..."
	json_dump
}

m_wechat_install_log() {
	local log="" running=0 exit_code=-1 state="idle" pid=""
	[ -f /tmp/openclaw-wechat-install.log ] && log=$(cat /tmp/openclaw-wechat-install.log 2>/dev/null)
	if [ -f /tmp/openclaw-wechat-install.pid ]; then
		pid=$(cat /tmp/openclaw-wechat-install.pid 2>/dev/null | tr -d '[:space:]')
		case "$pid" in *[!0-9]*|'') pid="" ;; esac
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			running=1
		fi
	fi
	if [ "$running" = "0" ] && [ -f /tmp/openclaw-wechat-install.exit ]; then
		exit_code=$(cat /tmp/openclaw-wechat-install.exit 2>/dev/null | tr -d '[:space:]')
		case "$exit_code" in ''|*[!0-9-]*) exit_code=-1 ;; esac
	fi
	if [ "$running" = "1" ]; then
		state="running"
	elif [ "$exit_code" = "0" ]; then
		state="success"
	elif [ "$exit_code" -gt 0 ] 2>/dev/null; then
		state="failed"
	fi
	json_init
	json_add_string "status" "ok"
	json_add_string "log" "$log"
	json_add_string "state" "$state"
	json_add_boolean "running" "$running"
	json_add_int "exit_code" "$exit_code"
	json_dump
}

m_wechat_login() {
	local install_path="$oc_root"
	local node_bin="$oc_node_bin"
	local oc_entry=""
	oc_entry=$(find_oc_entry)
	if [ -z "$oc_entry" ]; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "OpenClaw 未安装"
		json_dump
		return 0
	fi
	if ! ensure_openclaw_user "$oc_data"; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "无法创建或读取 openclaw 系统用户，请检查 /etc/passwd、/etc/group 是否可写"
		json_dump
		return 0
	fi

	# clean stale state / leftover login processes
	kill -9 "$(cat /tmp/openclaw-wechat-login.pid 2>/dev/null)" 2>/dev/null
	pkill -f 'channels login --channel openclaw-weixin' 2>/dev/null
	rm -f /tmp/openclaw-wechat-qrcode.txt /tmp/openclaw-wechat-login.pid /tmp/openclaw-wechat-login.exit /tmp/openclaw-wechat-restarted

	local wechat_plugin_dir=""
	if ! wechat_plugin_dir=$(find_wechat_plugin_dir); then
		wechat_write_log_and_exit \
			"/tmp/openclaw-wechat-qrcode.txt" \
			"/tmp/openclaw-wechat-login.exit" \
			"微信插件未安装...\n安装路径: $install_path\n未找到包含 openclaw.plugin.json 的微信插件目录。\n请先安装插件或重新安装插件。\n" \
			1
		json_init
		json_add_string "status" "error"
		json_add_string "message" "微信插件未安装或未找到，请先安装/重新安装插件"
		json_dump
		return 0
	fi

	# background login flow writing the QR link into the log file
	(
		{
			echo '正在启动微信登录...' > /tmp/openclaw-wechat-qrcode.txt
			echo "安装路径: $install_path" >> /tmp/openclaw-wechat-qrcode.txt
			echo "OpenClaw 入口: $oc_entry" >> /tmp/openclaw-wechat-qrcode.txt
			echo "微信插件目录: $wechat_plugin_dir" >> /tmp/openclaw-wechat-qrcode.txt
			echo "Node 版本: $("$node_bin" -v 2>/dev/null || echo 未检测到)" >> /tmp/openclaw-wechat-qrcode.txt
			if command -v python3 >/dev/null 2>&1; then
				echo 'python3: 已安装' >> /tmp/openclaw-wechat-qrcode.txt
			else
				echo '⚠️ python3: 未安装，微信插件可能无法完成配对' >> /tmp/openclaw-wechat-qrcode.txt
			fi
			wechat_network_probe /tmp/openclaw-wechat-qrcode.txt "$node_bin"
			mkdir -p "${oc_data}/.npm" "${oc_data}/.tmp" "${oc_data}/.openclaw/openclaw-weixin"
			touch "${oc_data}/.openclaw/openclaw.json" 2>/dev/null || true
			chown -R openclaw:openclaw "${oc_data}/.npm" "${oc_data}/.tmp" "${oc_data}/.openclaw/openclaw-weixin" 2>/dev/null
			chown openclaw:openclaw "${oc_data}/.openclaw" "${oc_data}/.openclaw/openclaw.json" 2>/dev/null
			run_as_openclaw "test -w ${oc_data}/.npm && test -w ${oc_data}/.tmp && test -w ${oc_data}/.openclaw && test -w ${oc_data}/.openclaw/openclaw-weixin && test -w ${oc_data}/.openclaw/openclaw.json" || {
				echo '❌ openclaw 用户无法写入微信登录目录，请检查数据目录权限' >> /tmp/openclaw-wechat-qrcode.txt
				echo 1 > /tmp/openclaw-wechat-login.exit
				return 0
			}
			RC=0
			wechat_enable_plugin_config "$node_bin" /tmp/openclaw-wechat-qrcode.txt /tmp/openclaw-wechat-login.exit
			wechat_finalize_plugin_registry /tmp/openclaw-wechat-qrcode.txt /tmp/openclaw-wechat-login.exit "$oc_entry"
			if [ "$RC" -ne 0 ]; then
				echo '❌ 微信插件注册失败，无法登录' >> /tmp/openclaw-wechat-qrcode.txt
				return 0
			fi
			run_as_openclaw "cd ${oc_data} && HOME=${oc_data} OPENCLAW_HOME=${oc_data} OPENCLAW_STATE_DIR=${oc_data}/.openclaw OPENCLAW_CONFIG_PATH=${oc_config_file} NODE_ICU_DATA=${oc_node_base}/share/icu NPM_CONFIG_CACHE=${oc_data}/.npm npm_config_cache=${oc_data}/.npm TMPDIR=${oc_data}/.tmp PATH=${oc_node_base}/bin:${oc_global}/bin:\$PATH $node_bin $oc_entry channels login --channel openclaw-weixin" >> /tmp/openclaw-wechat-qrcode.txt 2>&1
			echo $? > /tmp/openclaw-wechat-login.exit
		} 2>/dev/null
	) >/dev/null 2>&1 &
	echo $! > /tmp/openclaw-wechat-login.pid

	json_init
	json_add_string "status" "ok"
	json_add_string "message" "微信登录流程已启动"
	json_dump
}

m_wechat_login_status() {
	local qrcode="" running=0 exit_code=-1 pid=""
	[ -f /tmp/openclaw-wechat-qrcode.txt ] && qrcode=$(cat /tmp/openclaw-wechat-qrcode.txt 2>/dev/null)
	if [ -f /tmp/openclaw-wechat-login.pid ]; then
		pid=$(cat /tmp/openclaw-wechat-login.pid 2>/dev/null | tr -d '[:space:]')
		case "$pid" in *[!0-9]*|'') pid="" ;; esac
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			running=1
		fi
	fi
	if [ "$running" = "0" ] && [ -f /tmp/openclaw-wechat-login.exit ]; then
		exit_code=$(cat /tmp/openclaw-wechat-login.exit 2>/dev/null | tr -d '[:space:]')
		case "$exit_code" in ''|*[!0-9-]*) exit_code=-1 ;; esac
	fi

	# extract the real QR URL; ignore the connectivity probe URL to avoid
	# guiding the user to scan the wrong link
	local qrcode_url="" url urls
	urls=$(printf '%s\n' "$qrcode" | grep -o 'https\?://[^[:space:])}"'"'"'<>]\+' 2>/dev/null || true)
	for url in $urls; do
		case "$url" in
			*liteapp.weixin.qq.com/q/*|*weixin.qq.com/q/*) qrcode_url="$url" ;;
		esac
	done
	if [ -z "$qrcode_url" ]; then
		for url in $urls; do
			case "$url" in
				*ilinkai.weixin.qq.com*) ;;
				*) qrcode_url="$url" ;;
			esac
		done
	fi

	local logged_in=0
	printf '%s' "$qrcode" | grep -q "登录成功" && logged_in=1
	printf '%s' "$qrcode" | grep -q "成功登录" && logged_in=1
	printf '%s' "$qrcode" | grep -q "Login success" && logged_in=1
	printf '%s' "$qrcode" | grep -q "Logged in" && logged_in=1
	printf '%s' "$qrcode" | grep -q "已将此 OpenClaw 连接到微信" && logged_in=1
	printf '%s' "$qrcode" | grep -q "Local login saved auth for openclaw-weixin" && logged_in=1

	local state="idle" error_detail="" message=""
	if [ "$logged_in" = "1" ]; then
		state="success"
	elif [ "$running" = "1" ] && [ -n "$qrcode_url" ]; then
		state="qrcode"
	elif [ "$running" = "1" ]; then
		state="starting"
	elif [ "$exit_code" = "0" ]; then
		state="success"
	elif [ "$exit_code" -gt 0 ] 2>/dev/null; then
		state="failed"
	fi

	if [ "$state" = "failed" ]; then
		error_detail=$(wechat_tail_detail "$qrcode" 35)
		if [ -n "$error_detail" ]; then
			message="登录失败，下面是最近日志，请按提示处理"
		else
			message="登录失败，请查看 /tmp/openclaw-wechat-qrcode.txt"
		fi
	fi

	# on first success trigger a light gateway reload so the account loads
	if [ "$state" = "success" ] && [ ! -f /tmp/openclaw-wechat-restarted ]; then
		touch /tmp/openclaw-wechat-restarted
		/etc/init.d/openclaw restart_gateway >/dev/null 2>&1 &
		message="微信登录成功，正在重新加载微信账号"
	fi

	json_init
	json_add_string "status" "ok"
	json_add_string "state" "$state"
	json_add_string "qrcode" "$qrcode"
	json_add_string "qrcode_url" "$qrcode_url"
	json_add_boolean "running" "$running"
	json_add_int "exit_code" "$exit_code"
	json_add_boolean "logged_in" "$logged_in"
	json_add_string "message" "$message"
	json_add_string "error_detail" "$error_detail"
	json_dump
}

m_wechat_logout() {
	local account=""
	json_get_var account "account"
	if [ -z "$account" ]; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "参数错误：未提供账号 ID"
		json_dump
		return 0
	fi
	if printf '%s' "$account" | grep -q '[`$;&|<>"]' || printf '%s' "$account" | grep -q "'"; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "账号 ID 包含非法字符"
		json_dump
		return 0
	fi

	local oc_entry=""
	oc_entry=$(find_oc_entry)
	if [ -z "$oc_entry" ]; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "OpenClaw 未安装"
		json_dump
		return 0
	fi
	if ! ensure_openclaw_user "$oc_data"; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "无法创建或读取 openclaw 系统用户"
		json_dump
		return 0
	fi

	# background logout
	(
		cd "$oc_data" || true
		run_as_openclaw "HOME=${oc_data} OPENCLAW_HOME=${oc_data} OPENCLAW_STATE_DIR=${oc_data}/.openclaw OPENCLAW_CONFIG_PATH=${oc_config_file} NODE_ICU_DATA=${oc_node_base}/share/icu PATH=${oc_node_base}/bin:${oc_global}/bin:\$PATH $oc_node_bin $oc_entry channels logout --channel openclaw-weixin --account \"${account}\""
	) >/dev/null 2>&1 &

	# reload the gateway so the change takes effect
	/etc/init.d/openclaw restart >/dev/null 2>&1 &

	json_init
	json_add_string "status" "ok"
	json_add_string "message" "已下线账号: $account"
	json_dump
}

m_wechat_check_upgrade() {
	local npm_bin="$oc_npm_bin"
	local current_version="" latest_version="" check_err="" has_upgrade=0

	# current installed version (openclaw.plugin.json)
	local wechat_ext_dir="" plugin_json=""
	if ! wechat_ext_dir=$(find_wechat_plugin_dir); then
		wechat_ext_dir="${oc_data}/.openclaw/extensions/openclaw-weixin"
	fi
	plugin_json="${wechat_ext_dir}/openclaw.plugin.json"
	if [ -f "$plugin_json" ]; then
		current_version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$plugin_json" 2>/dev/null | head -n 1)
	fi

	# latest version via npm view (view is an npm subcommand — NOT npx)
	local raw=""
	raw=$(HOME="$oc_data" PATH="${oc_node_base}/bin:${oc_global}/bin:$PATH" "$npm_bin" view @tencent-weixin/openclaw-weixin version 2>&1 || true)
	latest_version=$(printf '%s' "$raw" | grep -o '\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*[0-9a-zA-Z._-]*\)[[:space:]]*$' | tail -1)
	if [ -z "$latest_version" ]; then
		check_err=$(printf '%s' "$raw" | sed 's/[[:space:]]*$//' | cut -c1-200)
	fi
	is_newer_version "$latest_version" "$current_version" && has_upgrade=1

	json_init
	if [ -n "$latest_version" ]; then
		json_add_string "status" "ok"
	else
		json_add_string "status" "error"
	fi
	json_add_string "current_version" "$current_version"
	json_add_string "latest_version" "$latest_version"
	json_add_boolean "has_upgrade" "$has_upgrade"
	if [ -n "$latest_version" ]; then
		json_add_string "message" ""
	else
		json_add_string "message" "无法查询最新版本 (请检查网络或 npm 源): $check_err"
	fi
	json_dump
}

m_wechat_uninstall() {
	local install_path="$oc_root"

	# remove plugin dirs and account state; every path is confined to OC data
	local wechat_ext_dir="${oc_data}/.openclaw/extensions/openclaw-weixin"
	local wechat_state_dir="${oc_data}/.openclaw/openclaw-weixin"
	local npm_projects="${oc_data}/.openclaw/npm/projects"
	rm -rf "$wechat_ext_dir" "$wechat_state_dir" 2>/dev/null
	if [ -d "$npm_projects" ]; then
		find "$npm_projects" -path '*/node_modules/@tencent-weixin/openclaw-weixin' -type d -prune -exec rm -rf {} + 2>/dev/null
		find "$npm_projects" -path '*/node_modules/@tencent-weixin/openclaw-weixin-cli' -type d -prune -exec rm -rf {} + 2>/dev/null
	fi

	# scrub wechat traces from openclaw.json (never unrelated config)
	if [ -f "$oc_config_file" ]; then
		if [ -x "$oc_node_bin" ]; then
			local cleanup_js="/tmp/oc-wechat-cleanup-$$.js"
			cat > "$cleanup_js" <<'NJS'
const fs = require('fs');
const p = process.env.OC_CONFIG;
let d = {};
try { d = JSON.parse(fs.readFileSync(p, 'utf8')); } catch (e) { process.exit(0); }
function drop(o, k) { if (o && typeof o === 'object') delete o[k]; }
function dropChannel(o) { drop(o, 'openclaw-weixin'); drop(o, 'weixin'); }
if (d.plugins && Array.isArray(d.plugins.allow)) {
  d.plugins.allow = d.plugins.allow.filter((x) => x !== 'openclaw-weixin' && x !== 'weixin');
}
if (d.plugins) {
  dropChannel(d.plugins.installs);
  dropChannel(d.plugins.entries);
}
dropChannel(d.channels);
dropChannel(d.channel);
dropChannel(d);
fs.writeFileSync(p, JSON.stringify(d, null, 2));
NJS
			OC_CONFIG="$oc_config_file" "$oc_node_bin" "$cleanup_js" 2>/dev/null
			rm -f "$cleanup_js"
		else
			local content=""
			content=$(cat "$oc_config_file" 2>/dev/null)
			content=$(printf '%s' "$content" | sed -e 's/,*[[:space:]]*"openclaw-weixin"[[:space:]]*:[[:space:]]*{[^}]*}//g' -e 's/"openclaw-weixin"[[:space:]]*:[[:space:]]*{[^}]*}[[:space:]]*,*//g')
			printf '%s\n' "$content" > "$oc_config_file"
		fi
		chown openclaw:openclaw "$oc_config_file" 2>/dev/null
	fi

	# temp files
	rm -f /tmp/openclaw-wechat-*.log /tmp/openclaw-wechat-*.pid /tmp/openclaw-wechat-*.exit /tmp/openclaw-wechat-qrcode.txt

	# restart the gateway so the loaded channel really goes away — otherwise the
	# in-memory channel writes its session cursor back into the deleted dir.
	/etc/init.d/openclaw restart >/dev/null 2>&1 &
	# re-clean the state dir after the async restart releases the file handles
	( sleep 6; rm -rf "$wechat_state_dir" 2>/dev/null ) &

	json_init
	json_add_string "status" "ok"
	json_add_string "message" "微信插件已卸载，网关正在重启"
	json_dump
}

# ===========================================================================
#  Device pairing (OpenClaw 2026.9.1+ Control UI approval)
#
#  The OpenClaw CLI speaks real JSON; the list/approve logic runs through a
#  tiny node helper (node is always present whenever the CLI exists — the CLI
#  is what we are driving). Decisions/guards from the former Lua actions are
#  preserved verbatim.
# ===========================================================================

# run the OpenClaw CLI with its full runtime env; stdout captured (stderr merged)
oc_devices_cli_capture() {
	local entry rc
	entry=$(find_oc_entry) || return 127
	[ -x "$oc_node_bin" ] || return 127
	ulimit -v unlimited 2>/dev/null || true
	ulimit -m unlimited 2>/dev/null || true
	ulimit -d unlimited 2>/dev/null || true
	HOME="$oc_data" OPENCLAW_HOME="$oc_data" \
	OPENCLAW_STATE_DIR="${oc_data}/.openclaw" \
	OPENCLAW_CONFIG_PATH="$oc_config_file" \
	NODE_ICU_DATA="${oc_node_base}/share/icu" \
	PATH="${oc_node_base}/bin:${oc_global}/bin:$PATH" \
	"$oc_node_bin" "$entry" "$@" 2>&1
	rc=$?
	return $rc
}

# shared node helper for pairing JSON handling. Modes:
#   list    < raw cli output on stdin → normalized reply JSON on stdout
#   listids < raw cli output on stdin → prints requestIds (one per line)
oc_devices_node() {
	local helper="/tmp/oc-devices-helper-$$.js"
	cat > "$helper" <<'NJS'
const fs = require('fs');
const raw = fs.readFileSync(0, 'utf8');
const mode = process.argv[1];
function hasArrays(j) {
  return (j && typeof j === 'object' &&
    (Array.isArray(j.pending) || Array.isArray(j.paired)));
}
if (mode === 'list') {
  try {
    const j = JSON.parse(raw);
    if (hasArrays(j))
      console.log(JSON.stringify({ status: 'ok', pending: j.pending || [], paired: j.paired || [] }));
    else
      console.log(JSON.stringify({ status: 'ok', pending: [], paired: [], raw: String(raw).slice(0, 300) }));
  } catch (e) {
    console.log(JSON.stringify({ status: 'ok', pending: [], paired: [], raw: String(raw).slice(0, 300) }));
  }
  process.exit(0);
}
if (mode === 'listids') {
  try {
    const j = JSON.parse(raw);
    const p = (j && Array.isArray(j.pending)) ? j.pending : [];
    for (const it of p)
      if (it && it.requestId && /^[a-zA-Z0-9\-_]+$/.test(it.requestId))
        console.log(it.requestId);
  } catch (e) { /* no ids */ }
  process.exit(0);
}
NJS
	"$oc_node_bin" "$helper" "$1" 2>/dev/null
	rm -f "$helper"
}

m_devices_list() {
	local out="" rc=0
	out=$(oc_devices_cli_capture devices list --json)
	rc=$?
	if [ $rc -ne 0 ] || [ -z "$out" ]; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "执行失败"
		json_add_array "pending"
		json_close_array
		json_add_array "paired"
		json_close_array
		json_dump
		return 0
	fi
	printf '%s' "$out" | oc_devices_node "list"
}

m_devices_approve() {
	local request_id="" all="" approve_all=0
	json_get_var request_id "request_id"
	json_get_var all "all"
	[ "$all" = "1" ] || [ "$all" = "true" ] && approve_all=1

	if [ "$approve_all" = "0" ] && { [ -z "$request_id" ] || [ "$request_id" = "null" ]; }; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "缺少 request_id 或 all 参数"
		json_dump
		return 0
	fi
	if [ "$approve_all" = "0" ] && ! printf '%s' "$request_id" | grep -q '^[a-zA-Z0-9_-]*$'; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "无效的请求 ID 格式"
		json_dump
		return 0
	fi
	[ "$approve_all" = "1" ] && request_id=""

	local ids="" rid="" out="" rc=0 approved=0
	if [ -n "$request_id" ]; then
		ids="$request_id"
	else
		local list_out=""
		list_out=$(oc_devices_cli_capture devices list --json)
		ids=$(printf '%s' "$list_out" | oc_devices_node "listids")
	fi

	json_init
	json_add_array "results"
	if [ -z "$ids" ] && [ "$approve_all" = "1" ]; then
		json_close_array
		json_add_int "success_count" 0
		json_add_int "fail_count" 0
		json_add_int "count" 0
		json_add_string "status" "ok"
		json_add_string "message" "当前没有待配对的设备请求"
		json_dump
		return 0
	fi

	local success_count=0 fail_count=0 n=0
	local old_ifs="$IFS"; IFS='
'
	for rid in $ids; do
		[ -n "$rid" ] || continue
		n=$((n + 1))
		out=$(oc_devices_cli_capture devices approve "$rid")
		rc=$?
		approved=0
		if [ $rc -eq 0 ] && ! printf '%s' "$out" | grep -q 'No pending device' && \
		   ! printf '%s' "$out" | grep -q 'Error' && ! printf '%s' "$out" | grep -q 'ERROR'; then
			approved=1
		fi
		if [ "$approved" = "0" ] && printf '%s' "$out" | grep -qi 'approved'; then
			approved=1
		fi
		json_add_object ""
		json_add_string "requestId" "$rid"
		if [ "$approved" = "1" ]; then
			json_add_boolean "ok" 1
			success_count=$((success_count + 1))
		else
			json_add_boolean "ok" 0
			fail_count=$((fail_count + 1))
		fi
		json_add_string "message" "${out:-批准失败}"
		json_close_object
	done
	IFS="$old_ifs"
	json_close_array

	json_add_int "success_count" "$success_count"
	json_add_int "fail_count" "$fail_count"
	json_add_int "count" "$n"
	fix_state_permissions "${oc_data}/.openclaw"
	if [ "$success_count" -gt 0 ]; then
		json_add_string "status" "ok"
		local msg="成功批准 ${success_count} 个设备配对请求"
		[ "$fail_count" -gt 0 ] && msg="${msg}，${fail_count} 个失败"
		json_add_string "message" "$msg"
	else
		json_add_string "status" "error"
		json_add_string "message" "批准设备配对失败"
	fi
	json_dump
}

# ===========================================================================
#  rpcd entry points
#
#  OPENCLAW_RPCD_SOURCED=1 allows sourcing this file as a test library
#  (functions only, no dispatch) — rpcd itself always executes it.
# ===========================================================================

if [ "${OPENCLAW_RPCD_SOURCED:-0}" = "1" ]; then
	return 0 2>/dev/null || exit 0
fi

case "${1:-}" in
	list)
		cat <<'EOF'
{"status":{},"service_ctl":{"action":"","version":"","install_path":""},"setup_log":{},"check_update":{},"uninstall":{},"get_token":{},"plugin_upgrade":{"version":""},"plugin_upgrade_log":{},"backup":{"action":"","only_config":"","file":""},"check_system":{"install_path":""},"wechat_status":{},"wechat_install":{},"wechat_install_log":{},"wechat_login":{},"wechat_login_status":{},"wechat_logout":{"account":""},"wechat_check_upgrade":{},"wechat_upgrade_plugin":{},"wechat_uninstall":{},"devices_list":{},"devices_approve":{"request_id":"","all":false}}
EOF
		;;
	call)
		method="${2:-}"
		if ! command -v json_init >/dev/null 2>&1; then
			echo '{"error":"jshn missing (install libubox)"}' >&2
			exit 1
		fi
		# runtime path resolution happens for every call
		load_runtime_paths
		# read args from stdin once
		input=$(cat)
		[ -n "$input" ] && json_load "$input" 2>/dev/null || json_init
		case "$method" in
			status)                m_status ;;
			service_ctl)           m_service_ctl ;;
			setup_log)             m_setup_log ;;
			check_update)          m_check_update ;;
			uninstall)             m_uninstall ;;
			get_token)             m_get_token ;;
			plugin_upgrade)        m_plugin_upgrade ;;
			plugin_upgrade_log)    m_plugin_upgrade_log ;;
			backup)                m_backup ;;
			check_system)          m_check_system ;;
			wechat_status)         m_wechat_status ;;
			wechat_install)        m_wechat_install ;;
			wechat_install_log)    m_wechat_install_log ;;
			wechat_login)          m_wechat_login ;;
			wechat_login_status)   m_wechat_login_status ;;
			wechat_logout)         m_wechat_logout ;;
			wechat_check_upgrade)  m_wechat_check_upgrade ;;
			wechat_upgrade_plugin) m_wechat_upgrade_plugin ;;
			wechat_uninstall)      m_wechat_uninstall ;;
			devices_list)          m_devices_list ;;
			devices_approve)       m_devices_approve ;;
			*)
				echo "{\"error\":\"unknown method: $method\"}"
				;;
		esac
		;;
	*)
		echo "{\"error\":\"usage: $0 list|call <method>\"}" >&2
		exit 1
		;;
esac
