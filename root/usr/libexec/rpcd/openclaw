#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# luci-app-openclaw — rpcd exec plugin (ubus object: "openclaw")
#
# Modern LuCI backend for the OpenClaw management UI. Replaces the former
# Lua controller (luasrc/controller/openclaw.lua): every privileged system
# operation (UCI, init.d, filesystem, Node.js, npm, OpenClaw CLI, wechat
# plugin, logs, install/uninstall/upgrade, device pairing) now lives here
# and is exposed as ubus methods consumed by the LuCI JS views via
#   htdocs/luci-static/resources/openclaw/api.js
#
# rpcd exec-plugin protocol (rpcd ≥ 18.06, unchanged ever since):
#   $0 list            → print a JSON object of {method: {param: <type-sample>}}
#   $0 call <method>   → JSON-RPC args arrive on stdin, JSON result on stdout
# rpcd parses ONLY stdout as the reply — all diagnostics go to stderr or to
# log files, never to stdout before the final JSON payload.
#
# Node.js code fragments are written to /tmp helper files with quoted
# heredocs and executed via the installed runtime — no shell-quote escapes
# involved. Every command that must run as the "openclaw" service user goes
# through run_as_openclaw(); paths are resolved from UCI openclaw.main.
# ═══════════════════════════════════════════════════════════════════════════

PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/libexec"
export PATH

# ── shared shell helpers (path / node / permissions libs) ───────────────
[ -r /usr/libexec/openclaw-paths.sh ] && . /usr/libexec/openclaw-paths.sh
[ -r /usr/libexec/openclaw-node.sh ] && . /usr/libexec/openclaw-node.sh

# permissions.sh is normally executed standalone; force library mode here.
OPENCLAW_PERMISSIONS_SOURCED=1
[ -r /usr/libexec/openclaw-permissions.sh ] && . /usr/libexec/openclaw-permissions.sh

# jshn (libubox) supplies the JSON helpers — load it when present.
if [ -r /usr/share/libubox/jshn.sh ]; then
	. /usr/share/libubox/jshn.sh
fi

# oc_quote from openclaw-paths.sh; fallback single-quote escaper.
sq() {
	if command -v oc_quote >/dev/null 2>&1; then
		oc_quote "$1"
	else
		printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
	fi
}

# ── runtime paths (authoritative source: UCI openclaw.main.install_path) ─
oc_base=""
oc_root=""
oc_node_base=""
oc_global=""
oc_data=""
oc_config_file=""
oc_node_bin=""
oc_npm_bin=""
oc_npx_bin=""

load_runtime_paths() {
	local configured=""
	configured=$(uci -q get openclaw.main.install_path 2>/dev/null || printf '/opt')
	if command -v oc_load_paths >/dev/null 2>&1 && oc_load_paths "$configured"; then
		oc_base="$OPENCLAW_INSTALL_PATH"
		oc_root="$OC_ROOT"
		oc_node_base="$NODE_BASE"
		oc_global="$OC_GLOBAL"
		oc_data="$OC_DATA"
		oc_config_file="$CONFIG_FILE"
	else
		oc_base=$(printf '%s' "$configured" | sed 's:^[[:space:]]*::;s:[[:space:]]*$::;s:/*$::')
		[ -n "$oc_base" ] || oc_base="/"
		if [ "$oc_base" = "/" ]; then
			oc_root="/openclaw"
		else
			oc_root="${oc_base}/openclaw"
		fi
		oc_node_base="${oc_root}/node"
		oc_global="${oc_root}/global"
		oc_data="${oc_root}/data"
		oc_config_file="${oc_data}/.openclaw/openclaw.json"
	fi
	oc_node_bin="${oc_node_base}/bin/node"
	oc_npm_bin="${oc_node_base}/bin/npm"
	oc_npx_bin="${oc_node_base}/bin/npx"
}

# is_safe_openclaw_root — whitelist identical to the old luasrc/openclaw/paths.lua
is_safe_openclaw_root() {
	local value="$1"
	case "$value" in
		/openclaw|/opt/openclaw|/overlay/upper/opt/openclaw) return 0 ;;
	esac
	case "$value" in
		/mnt/*/openclaw|/media/*/openclaw|/srv/*/openclaw) return 0 ;;
	esac
	return 1
}

# find the OpenClaw CLI entry (openclaw.mjs preferred, dist/cli.js fallback)
find_oc_entry() {
	local d=""
	for d in "${oc_root}/global/lib/node_modules/openclaw" \
	         "${oc_root}/global/node_modules/openclaw" \
	         "${oc_root}/node/lib/node_modules/openclaw"; do
		if [ -f "$d/openclaw.mjs" ]; then
			printf '%s\n' "$d/openclaw.mjs"
			return 0
		elif [ -f "$d/dist/cli.js" ]; then
			printf '%s\n' "$d/dist/cli.js"
			return 0
		fi
	done
	return 1
}

# find the installed wechat plugin directory
find_wechat_plugin_dir() {
	local ext_dir npm_projects plugin_json
	ext_dir="${oc_data}/.openclaw/extensions/openclaw-weixin"
	if [ -f "$ext_dir/openclaw.plugin.json" ]; then
		printf '%s\n' "$ext_dir"
		return 0
	fi
	npm_projects="${oc_data}/.openclaw/npm/projects"
	if [ -d "$npm_projects" ]; then
		plugin_json=$(find "$npm_projects" -path '*/node_modules/@tencent-weixin/openclaw-weixin/openclaw.plugin.json' -type f 2>/dev/null | head -n 1)
		if [ -n "$plugin_json" ]; then
			printf '%s\n' "$plugin_json" | sed 's:/openclaw\.plugin\.json$::'
			return 0
		fi
	fi
	return 1
}

ensure_openclaw_user() {
	local uid=""
	uid=$(id -u openclaw 2>/dev/null | tr -d '[:space:]')
	[ -n "$uid" ] && return 0

	local data_dir="$1" OC_UID OC_GID
	OC_UID=1000
	while grep -q "^[^:]*:x:${OC_UID}:" /etc/passwd 2>/dev/null; do
		OC_UID=$((OC_UID + 1))
	done
	OC_GID=$OC_UID
	while grep -q "^[^:]*:x:${OC_GID}:" /etc/group 2>/dev/null; do
		OC_GID=$((OC_GID + 1))
	done
	grep -q '^openclaw:' /etc/passwd 2>/dev/null || \
		echo "openclaw:x:${OC_UID}:${OC_GID}:openclaw:${data_dir}:/bin/false" >> /etc/passwd
	grep -q '^openclaw:' /etc/shadow 2>/dev/null || \
		echo 'openclaw:x:0:0:99999:7:::' >> /etc/shadow
	grep -q '^openclaw:' /etc/group 2>/dev/null || \
		echo "openclaw:x:${OC_GID}:" >> /etc/group
	uid=$(id -u openclaw 2>/dev/null | tr -d '[:space:]')
	[ -n "$uid" ]
}

# run a command string as the openclaw user (su → runuser → start-stop-daemon)
run_as_openclaw() {
	local command="$1"
	ulimit -v unlimited 2>/dev/null || true
	ulimit -m unlimited 2>/dev/null || true
	ulimit -d unlimited 2>/dev/null || true
	if command -v su >/dev/null 2>&1; then
		su -s /bin/sh openclaw -c "$command"
	elif command -v runuser >/dev/null 2>&1; then
		runuser -u openclaw -- sh -c "$command"
	elif command -v start-stop-daemon >/dev/null 2>&1; then
		local pid_file="/tmp/openclaw-user-$$.pid" cwd rc
		cwd=$(pwd 2>/dev/null || printf '/tmp')
		rm -f "$pid_file"
		( cd "$cwd" 2>/dev/null || cd /tmp; start-stop-daemon -S -m -p "$pid_file" -c openclaw:openclaw -x /bin/sh -- -c "$command" )
		rc=$?
		rm -f "$pid_file"
		return $rc
	else
		echo '❌ 缺少 su/runuser/start-stop-daemon，无法以 openclaw 用户运行命令' >&2
		return 127
	fi
}

# run a node helper file with the OpenClaw runtime env (root). usage:
#   oc_run_node <js-file> [args...]   → stdout only from the script
oc_run_node() {
	local js="$1" rc
	shift
	NODE_ICU_DATA="${oc_node_base}/share/icu" \
	"$oc_node_bin" "$js" "$@" 2>/dev/null
	rc=$?
	rm -f "$js"
	return $rc
}

# fix openclaw state permissions (post-approve / post-install / restore)
fix_state_permissions() {
	local state_dir="${1:-${oc_data}/.openclaw}"
	if [ -x /usr/libexec/openclaw-permissions.sh ]; then
		/usr/libexec/openclaw-permissions.sh fix-state "$state_dir" >/dev/null 2>&1 || true
	fi
}

# version compare helpers (numeric dotted segments; identical to the old Lua one)
ver_cmp() {
	# prints: 0 equal, 1 a>b, 2 a<b ; strips leading v and non-numeric noise
	local a b
	a=$(printf '%s' "$1" | sed 's/^v//;s/[^0-9.]//g')
	b=$(printf '%s' "$2" | sed 's/^v//;s/[^0-9.]//g')
	awk -v a="$a" -v b="$b" 'BEGIN {
		na = split(a, av, "."); nb = split(b, bv, ".");
		n = (na > nb) ? na : nb;
		for (i = 1; i <= n; i++) {
			x = (i <= na) ? av[i] + 0 : 0;
			y = (i <= nb) ? bv[i] + 0 : 0;
			if (x > y) { print 1; exit }
			if (x < y) { print 2; exit }
		}
		print 0
	}'
}

is_newer_version() {
	local latest="$1" current="$2"
	[ -n "$latest" ] && [ -n "$current" ] && [ "$latest" != "" ] && [ "$current" != "" ] || return 1
	[ "$(ver_cmp "$latest" "$current")" = "1" ]
}

# read the upgrade transaction status.json (state machine written by openclaw-env)
read_upgrade_status() {
	up_phase="idle"; up_target=""; up_backup=0; up_migrated=0; up_rollback="none"; up_error=0
	local fpath content=""
	for fpath in \
		"${oc_root}/.luci-openclaw-upgrade/status.json" \
		"${oc_data}/.luci-openclaw-upgrade/status.json" \
		"${oc_data}/.openclaw/.luci-openclaw-upgrade/status.json" \
		"/tmp/.luci-openclaw-upgrade/status.json"; do
		[ -f "$fpath" ] || continue
		content=$(cat "$fpath" 2>/dev/null)
		[ -n "$content" ] || continue
		local v
		v=$(printf '%s' "$content" | sed -n 's/.*"phase"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
		[ -n "$v" ] && up_phase="$v"
		v=$(printf '%s' "$content" | sed -n 's/.*"target_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
		[ -n "$v" ] && up_target="$v"
		v=$(printf '%s' "$content" | sed -n 's/.*"backup_verified"[[:space:]]*:[[:space:]]*\([a-z]*\).*/\1/p')
		[ "$v" = "true" ] && up_backup=1
		v=$(printf '%s' "$content" | sed -n 's/.*"migration_started"[[:space:]]*:[[:space:]]*\([a-z]*\).*/\1/p')
		[ "$v" = "true" ] && up_migrated=1
		v=$(printf '%s' "$content" | sed -n 's/.*"rollback_mode"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
		[ -n "$v" ] && up_rollback="$v"
		v=$(printf '%s' "$content" | sed -n 's/.*"error_code"[[:space:]]*:[[:space:]]*"\{0,1\}\(-\{0,1\}[0-9]*\)"\{0,1\}.*/\1/p')
		case "$v" in
			''|*[!0-9-]*) up_error=0 ;;
			*) up_error=$((v + 0)) ;;
		esac
		break
	done
}

# does something listen on a numeric port?
port_busy() {
	local port="$1" out=""
	case "$port" in
		''|*[!0-9]*) return 1 ;;
	esac
	if command -v ss >/dev/null 2>&1; then
		out=$(ss -tulnp 2>/dev/null | grep -c ":${port} " 2>/dev/null || printf '0')
	else
		out=$(netstat -tulnp 2>/dev/null | grep -c ":${port} " 2>/dev/null || printf '0')
	fi
	[ "$(printf '%s' "$out" | tr -d '[:space:]')" -ge 1 ] 2>/dev/null
}

port_pid() {
	local port="$1" pid=""
	pid=$(netstat -tulnp 2>/dev/null | awk '/:'"$port"' /{split($NF,a,"/");print a[1];exit}' 2>/dev/null | tr -d '[:space:]')
	case "$pid" in
		''|*[!0-9]*) printf '' ;;
		*) printf '%s\n' "$pid" ;;
	esac
}

# json config value extraction (openclaw.json; regex extraction mirrors old Lua)
config_value() {
	local file="$1" key="$2"
	[ -f "$file" ] || return 1
	sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$file" 2>/dev/null | head -n 1
}

format_size() {
	local size="$1"
	awk -v s="$size" 'BEGIN {
		if (s >= 1073741824) printf "%.1f GB", s/1073741824
		else if (s >= 1048576) printf "%.1f MB", s/1048576
		else if (s >= 1024) printf "%.1f KB", s/1024
		else printf "%d B", s
	}'
}

# tail last N meaningful lines (strip ANSI/blank) — port of wechat_tail_detail
wechat_tail_detail() {
	local text="$1" max="${2:-30}" esc
	[ -n "$text" ] || return 0
	esc=$(printf '\033')
	printf '%s\n' "$text" | sed "s/${esc}\[[0-9;]*m//g" | grep -v '^[[:space:]]*$' | tail -n "$max"
}

# ===========================================================================
#  METHODS
# ===========================================================================

# ---- openclaw.status -------------------------------------------------------
m_status() {
	local enabled port pty_port plugin_version=""
	enabled=$(uci -q get openclaw.main.enabled 2>/dev/null || printf '0')
	port=$(uci -q get openclaw.main.port 2>/dev/null || printf '18789')
	pty_port=$(uci -q get openclaw.main.pty_port 2>/dev/null || printf '18793')
	case "$port" in ''|*[!0-9]*) port=18789 ;; esac
	case "$pty_port" in ''|*[!0-9]*) pty_port=18793 ;; esac

	local install_path="$oc_root"
	local node_version="" oc_version="" disk_free="" pid="" memory_kb=0 uptime=""
	local gateway_running=0 gateway_starting=0 gateway_failed=0 gateway_crash_loop=0
	local gateway_exit_code="" active_model="" channels=""

	[ -f /usr/share/openclaw/VERSION ] && \
		plugin_version=$(tr -d '[:space:]' < /usr/share/openclaw/VERSION 2>/dev/null)

	if [ -x "$oc_node_bin" ]; then
		node_version=$("$oc_node_bin" --version 2>/dev/null | tr -d '[:space:]')
	fi

	local d pj=""
	for d in "${oc_root}/global/lib/node_modules/openclaw" \
	         "${oc_root}/global/node_modules/openclaw" \
	         "${oc_root}/node/lib/node_modules/openclaw"; do
		if [ -f "$d/package.json" ]; then
			pj=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$d/package.json" 2>/dev/null | head -n 1)
			if [ -n "$pj" ]; then
				oc_version="$pj"
				break
			fi
		fi
	done

	if port_busy "$port"; then
		gateway_running=1
	fi

	if [ "$gateway_running" = "0" ] && [ "$enabled" = "1" ]; then
		local plist procd_pid="" procd_running="" procd_exit="" pidfile_pid="" crash_loop=""
		plist=$(ubus call service list '{"name":"openclaw"}' 2>/dev/null)
		procd_pid=$(printf '%s' "$plist" | jsonfilter -e '$.openclaw.instances.gateway.pid' 2>/dev/null | tr -d '[:space:]')
		procd_running=$(printf '%s' "$plist" | jsonfilter -e '$.openclaw.instances.gateway.running' 2>/dev/null | tr -d '[:space:]')
		procd_exit=$(printf '%s' "$plist" | jsonfilter -e '$.openclaw.instances.gateway.exit_code' 2>/dev/null | tr -d '[:space:]')
		[ "$procd_pid" = "null" ] && procd_pid=""
		case "$procd_pid" in
			*[!0-9]*|'') procd_pid="" ;;
		esac
		[ "$procd_exit" = "null" ] && procd_exit=""
		gateway_exit_code="$procd_exit"

		local procd_pid_alive=0 pidfile_stale=0
		if [ -n "$procd_pid" ] && [ -d "/proc/$procd_pid" ]; then
			procd_pid_alive=1
		fi
		pidfile_pid=$(cat /var/run/openclaw.pid 2>/dev/null | tr -d '[:space:]')
		case "$pidfile_pid" in
			*[!0-9]*|'') pidfile_pid="" ;;
		esac
		if [ -n "$pidfile_pid" ] && [ ! -d "/proc/$pidfile_pid" ]; then
			pidfile_stale=1
		fi
		crash_loop=$(logread 2>/dev/null | grep -E 'Instance openclaw::gateway.*crash loop' | tail -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

		if [ -n "$procd_exit" ] && [ "$procd_exit" != "0" ] && [ "$procd_running" != "true" ]; then
			gateway_failed=1
		elif [ -n "$crash_loop" ] && [ "$pidfile_stale" = "1" ] && [ "$procd_running" != "true" ] && [ "$procd_pid_alive" = "0" ]; then
			gateway_failed=1
			gateway_crash_loop=1
			[ -z "$gateway_exit_code" ] && gateway_exit_code="crash-loop"
		elif [ "$procd_running" = "true" ] || [ "$procd_pid_alive" = "1" ]; then
			gateway_starting=1
			pid="$procd_pid"
		fi
	fi

	local pty_running=0
	port_busy "$pty_port" && pty_running=1

	# active model & channels from openclaw.json (identical detection to the old code)
	local content=""
	if [ -f "$oc_config_file" ]; then
		content=$(cat "$oc_config_file" 2>/dev/null)
		active_model=$(printf '%s' "$content" | sed -n 's/.*"primary"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
		if printf '%s' "$content" | grep -q '"openclaw-weixin"[[:space:]]*:[[:space:]]*{'; then
			[ -z "$channels" ] || channels="${channels}, "
			channels="${channels}微信"
		fi
		if printf '%s' "$content" | grep -q '"qqbot"[[:space:]]*:[[:space:]]*{' && printf '%s' "$content" | grep -q '"appId"[[:space:]]*:[[:space:]]*"[^"]*"'; then
			[ -z "$channels" ] || channels="${channels}, "
			channels="${channels}QQ"
		fi
		if printf '%s' "$content" | grep -q '"telegram"[[:space:]]*:[[:space:]]*{' && printf '%s' "$content" | grep -q '"botToken"[[:space:]]*:[[:space:]]*"[^"]*"'; then
			[ -z "$channels" ] || channels="${channels}, "
			channels="${channels}Telegram"
		fi
		if printf '%s' "$content" | grep -q '"discord"[[:space:]]*:[[:space:]]*{'; then
			[ -z "$channels" ] || channels="${channels}, "
			channels="${channels}Discord"
		fi
		if printf '%s' "$content" | grep -q '"feishu"[[:space:]]*:[[:space:]]*{'; then
			[ -z "$channels" ] || channels="${channels}, "
			channels="${channels}飞书"
		fi
		if printf '%s' "$content" | grep -q '"slack"[[:space:]]*:[[:space:]]*{'; then
			[ -z "$channels" ] || channels="${channels}, "
			channels="${channels}Slack"
		fi
	fi

	if [ "$gateway_running" = "1" ]; then
		pid=$(port_pid "$port")
		if [ -n "$pid" ]; then
			memory_kb=$(awk '/VmRSS/{print $2}' "/proc/$pid/status" 2>/dev/null | tr -d '[:space:]')
			case "$memory_kb" in ''|*[!0-9]*) memory_kb=0 ;; esac
			local start_ts now_ts h m s
			start_ts=$(stat -c %Y "/proc/$pid" 2>/dev/null | tr -d '[:space:]')
			case "$start_ts" in ''|*[!0-9]*) start_ts=0 ;; esac
			if [ "$start_ts" -gt 0 ] 2>/dev/null; then
				now_ts=$(date +%s)
				local diff=$((now_ts - start_ts))
				h=$((diff / 3600)); m=$(((diff % 3600) / 60)); s=$((diff % 60))
				if [ "$h" -gt 0 ]; then
					uptime="${h}h ${m}m ${s}s"
				elif [ "$m" -gt 0 ]; then
					uptime="${m}m ${s}s"
				else
					uptime="${s}s"
				fi
			fi
		fi
	fi

	# disk free on the partition holding the install root
	local parent disk_free_raw
	parent=$(printf '%s' "$install_path" | sed 's:\(.*\)/[^/]*$:\1:')
	case "$parent" in '') parent="/" ;; esac
	disk_free_raw=$(df -h "$parent" 2>/dev/null | tail -1 | awk '{print $4}' | tr -d '[:space:]')
	[ -n "$disk_free_raw" ] && disk_free="$disk_free_raw"

	read_upgrade_status

	json_init
	json_add_string "enabled" "$enabled"
	json_add_string "port" "$port"
	json_add_string "pty_port" "$pty_port"
	json_add_string "install_path" "$install_path"
	json_add_boolean "gateway_running" "$gateway_running"
	json_add_boolean "gateway_starting" "$gateway_starting"
	json_add_boolean "gateway_failed" "$gateway_failed"
	[ -n "$gateway_exit_code" ] && json_add_string "gateway_exit_code" "$gateway_exit_code"
	if [ "$gateway_crash_loop" = "1" ]; then
		json_add_boolean "gateway_crash_loop" 1
	fi
	json_add_boolean "pty_running" "$pty_running"
	json_add_string "pid" "$pid"
	json_add_int "memory_kb" "$memory_kb"
	json_add_string "uptime" "$uptime"
	json_add_string "node_version" "$node_version"
	json_add_string "oc_version" "$oc_version"
	json_add_string "plugin_version" "$plugin_version"
	json_add_string "disk_free" "$disk_free"
	[ -n "$active_model" ] && json_add_string "active_model" "$active_model"
	[ -n "$channels" ] && json_add_string "channels" "$channels"
	# upgrade transaction state
	json_add_string "phase" "$up_phase"
	json_add_string "target_version" "$up_target"
	json_add_boolean "backup_verified" "$up_backup"
	json_add_boolean "migration_started" "$up_migrated"
	json_add_string "rollback_mode" "$up_rollback"
	json_add_int "error_code" "$up_error"
	json_dump
}

# ---- openclaw.service_ctl --------------------------------------------------
m_service_ctl() {
	local action="" version="" install_path=""
	json_get_var action "action"
	json_get_var version "version"
	json_get_var install_path "install_path"

	case "$action" in
		start)
			/etc/init.d/openclaw start >/dev/null 2>&1 &
			;;
		stop)
			/etc/init.d/openclaw stop >/dev/null 2>&1
			sleep 2
			;;
		restart)
			# restart only the gateway, never the Web PTY (fast path).
			# Fall back to a full start when procd has no gateway instance yet.
			local procd_running=""
			procd_running=$(ubus call service list '{"name":"openclaw"}' 2>/dev/null | jsonfilter -e '$.openclaw.instances.gateway.running' 2>/dev/null | tr -d '[:space:]')
			if [ "$procd_running" = "true" ]; then
				/etc/init.d/openclaw restart_gateway >/dev/null 2>&1 &
			else
				/etc/init.d/openclaw start >/dev/null 2>&1 &
			fi
			;;
		enable)
			/etc/init.d/openclaw enable 2>/dev/null
			;;
		disable)
			/etc/init.d/openclaw disable 2>/dev/null
			;;
		setup)
			rm -f /tmp/openclaw-setup.log /tmp/openclaw-setup.pid /tmp/openclaw-setup.exit
			local env_prefix=""
			if [ "$version" = "stable" ]; then
				local tested=""
				tested=$(sed -n 's/^OC_TESTED_VERSION="\(.*\)"/\1/p' /usr/bin/openclaw-env 2>/dev/null | tr -d '[:space:]')
				if [ -n "$tested" ]; then
					env_prefix="OC_VERSION=$(sq "$tested")"
				fi
			elif [ "$version" = "latest" ]; then
				env_prefix="OC_VERSION='latest'"
			elif [ -n "$version" ] && [ "$version" != "stable" ]; then
				case "$version" in
					*[!0-9a-zA-Z.-]*|'') ;;
					*) env_prefix="OC_VERSION=$(sq "$version")" ;;
				esac
			fi
			if [ -n "$install_path" ]; then
				local normalized=""
				normalized=$(oc_normalize_install_path "$install_path") || {
					json_init
					json_add_string "status" "error"
					json_add_string "message" "安装路径无效：必须是绝对路径，且不能包含空格、引号或 shell 特殊字符。"
					json_dump
					return 0
				}
				uci set openclaw.main.install_path="$normalized"
				uci commit openclaw 2>/dev/null
				if [ -n "$env_prefix" ]; then
					env_prefix="${env_prefix} OC_INSTALL_PATH=$(sq "$normalized")"
				else
					env_prefix="OC_INSTALL_PATH=$(sq "$normalized")"
				fi
			fi
			# background install; auto enable+start on success (openclaw-env has set -e)
			( eval "$env_prefix /usr/bin/openclaw-env setup" > /tmp/openclaw-setup.log 2>&1; RC=$?; \
			  echo "$RC" > /tmp/openclaw-setup.exit; \
			  if [ "$RC" -eq 0 ]; then uci set openclaw.main.enabled=1; uci commit openclaw; \
			     /etc/init.d/openclaw enable 2>/dev/null; sleep 1; \
			     /etc/init.d/openclaw start >> /tmp/openclaw-setup.log 2>&1; fi ) &
			echo $! > /tmp/openclaw-setup.pid
			json_init
			json_add_string "status" "ok"
			json_add_string "message" "安装已启动，请查看安装日志..."
			json_dump
			return 0
			;;
		upgrade)
			rm -f /tmp/openclaw-setup.log /tmp/openclaw-setup.pid /tmp/openclaw-setup.exit
			local target_ver="$version"
			local env_prefix=""
			if [ "$target_ver" = "latest" ]; then
				env_prefix="OC_VERSION='latest'"
			elif [ -n "$target_ver" ] && [ "$target_ver" != "stable" ]; then
				case "$target_ver" in
					*[!0-9a-zA-Z.-]*|'') ;;
					*) env_prefix="OC_VERSION=$(sq "$target_ver")" ;;
				esac
			fi
			( eval "$env_prefix /usr/bin/openclaw-env upgrade" > /tmp/openclaw-setup.log 2>&1; \
			  echo $? > /tmp/openclaw-setup.exit ) &
			echo $! > /tmp/openclaw-setup.pid
			json_init
			json_add_string "status" "ok"
			json_add_string "message" "OpenClaw 核心升级已启动，正在执行安全事务..."
			json_dump
			return 0
			;;
		*)
			json_init
			json_add_string "status" "error"
			json_add_string "message" "未知操作: $action"
			json_dump
			return 0
			;;
	esac

	json_init
	json_add_string "status" "ok"
	json_add_string "action" "$action"
	json_dump
}

# ---- openclaw.setup_log ----------------------------------------------------
m_setup_log() {
	local log="" running=0 exit_code=-1 state="idle" pid=""
	[ -f /tmp/openclaw-setup.log ] && log=$(cat /tmp/openclaw-setup.log 2>/dev/null)
	if [ -f /tmp/openclaw-setup.pid ]; then
		pid=$(cat /tmp/openclaw-setup.pid 2>/dev/null | tr -d '[:space:]')
		case "$pid" in
			*[!0-9]*|'') pid="" ;;
		esac
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			running=1
		fi
	fi
	if [ "$running" = "0" ] && [ -f /tmp/openclaw-setup.exit ]; then
		exit_code=$(cat /tmp/openclaw-setup.exit 2>/dev/null | tr -d '[:space:]')
		case "$exit_code" in
			''|*[!0-9-]*) exit_code=-1 ;;
		esac
	fi
	if [ "$running" = "1" ]; then
		state="running"
	elif [ "$exit_code" = "0" ]; then
		state="success"
	elif [ "$exit_code" -gt 0 ] 2>/dev/null; then
		state="failed"
	fi
	read_upgrade_status
	json_init
	json_add_string "state" "$state"
	json_add_int "exit_code" "$exit_code"
	json_add_string "log" "$log"
	json_add_string "phase" "$up_phase"
	json_add_string "target_version" "$up_target"
	json_add_boolean "backup_verified" "$up_backup"
	json_add_boolean "migration_started" "$up_migrated"
	json_add_string "rollback_mode" "$up_rollback"
	json_add_int "error_code" "$up_error"
	json_dump
}

# ---- openclaw.check_update -------------------------------------------------
m_check_update() {
	# 1) plugin version check (GitHub latest release tag + notes)
	local plugin_current="" plugin_latest="" release_notes="" plugin_has_update=0
	if [ -f /usr/share/openclaw/VERSION ]; then
		plugin_current=$(tr -d '[:space:]' < /usr/share/openclaw/VERSION 2>/dev/null)
	elif [ -f /root/luci-app-openclaw/VERSION ]; then
		plugin_current=$(tr -d '[:space:]' < /root/luci-app-openclaw/VERSION 2>/dev/null)
	fi

	local gh_json="" tag="" body=""
	gh_json=$(curl -sf --connect-timeout 5 --max-time 10 'https://api.github.com/repos/10000ge10000/luci-app-openclaw/releases/latest' 2>/dev/null)
	if [ -n "$gh_json" ]; then
		# parse with jshn for exact strings (no manual JSON unescaping)
		if json_load "$gh_json" 2>/dev/null; then
			json_get_var tag "tag_name"
			json_get_var body "body"
		fi
		if [ -n "$tag" ]; then
			plugin_latest=$(printf '%s' "$tag" | sed 's/^v//' | tr -d '[:space:]')
		fi
		if [ -n "$body" ]; then
			release_notes="$body"
		fi
	fi
	is_newer_version "$plugin_latest" "$plugin_current" && plugin_has_update=1

	# 2) OpenClaw core version check
	local openclaw_current="" openclaw_latest="" openclaw_has_update=0 oc_check_str=""
	oc_check_str=$(/usr/bin/openclaw-env check 2>/dev/null | grep -i 'OpenClaw:' | head -1 | tr -d '[:space:]')
	if [ -n "$oc_check_str" ]; then
		openclaw_current=$(printf '%s' "$oc_check_str" | sed -n 's/.*[vV]\{0,1\}\([0-9][0-9.]*[-0-9]*\).*/\1/p')
	fi
	if [ -z "$openclaw_current" ] || [ "$openclaw_current" = "未安装" ]; then
		local candidate="/opt/openclaw/global/lib/node_modules/openclaw/package.json"
		if [ -f "$candidate" ]; then
			openclaw_current=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$candidate" 2>/dev/null | head -n 1)
		fi
	fi
	local tested=""
	tested=$(sed -n 's/^OC_TESTED_VERSION="\(.*\)"/\1/p' /usr/bin/openclaw-env 2>/dev/null | tr -d '[:space:]')
	[ -n "$tested" ] || tested="2026.9.1"
	openclaw_latest="$tested"
	if [ -n "$openclaw_current" ] && [ "$openclaw_current" != "未安装" ] && [ -n "$openclaw_latest" ]; then
		is_newer_version "$openclaw_latest" "$openclaw_current" && openclaw_has_update=1
	fi

	json_init
	json_add_string "status" "ok"
	json_add_string "plugin_current" "$plugin_current"
	json_add_string "plugin_latest" "$plugin_latest"
	json_add_boolean "plugin_has_update" "$plugin_has_update"
	[ -n "$release_notes" ] && json_add_string "release_notes" "$release_notes"
	json_add_string "openclaw_current" "$openclaw_current"
	json_add_string "openclaw_latest" "$openclaw_latest"
	json_add_boolean "openclaw_has_update" "$openclaw_has_update"
	json_dump
}

# ---- openclaw.uninstall ----------------------------------------------------
m_uninstall() {
	local configured_base normalized_base
	configured_base=$(uci -q get openclaw.main.install_path 2>/dev/null || printf '/opt')
	normalized_base=$(oc_normalize_install_path "$configured_base")
	if [ -z "$normalized_base" ]; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "UCI 安装路径无效，已取消卸载: $configured_base"
		json_dump
		return 0
	fi
	local install_path
	if [ "$normalized_base" = "/" ]; then
		install_path="/openclaw"
	else
		install_path="${normalized_base}/openclaw"
	fi
	if ! is_safe_openclaw_root "$install_path"; then
		json_init
		json_add_string "status" "error"
		json_add_string "message" "安装路径未通过安全校验，已取消卸载: $install_path"
		json_dump
		return 0
	fi

	# 1. stop the service through the normal init.d flow
	/etc/init.d/openclaw stop >/dev/null 2>&1

	# 2. read ports so anything still bound is killed before cleanup
	local port pty_port pid p
	port=$(uci -q get openclaw.main.port 2>/dev/null || printf '18789')
	pty_port=$(uci -q get openclaw.main.pty_port 2>/dev/null || printf '18793')
	case "$port" in ''|*[!0-9]*) port=18789 ;; esac
	case "$pty_port" in ''|*[!0-9]*) pty_port=18793 ;; esac

	# 3. ruthless zombie cleanup
	for p in "$port" "$pty_port"; do
		pid=$(netstat -tulnp 2>/dev/null | grep ":$p " | awk '{print $7}' | cut -d'/' -f1)
		[ -n "$pid" ] && kill -9 "$pid" 2>/dev/null
	done
	ss -tulnp 2>/dev/null | awk '/:'"$port"' |:'"$pty_port"' /{print $NF}' | awk -F',' '{print $2}' | awk -F'=' '{print $2}' | xargs -r kill -9 2>/dev/null
	pgrep -f 'openclaw-gateway|web-pty.js' 2>/dev/null | xargs -r kill -9 2>/dev/null
	pgrep -u openclaw 2>/dev/null | xargs -r kill -9 2>/dev/null

	# 4. disable autostart & clear the enabled flag
	/etc/init.d/openclaw disable 2>/dev/null
	uci set openclaw.main.enabled=0
	uci commit openclaw 2>/dev/null

	# 5. remove the runtime (Node.js + OpenClaw + all plugins)
	umount "$install_path" 2>/dev/null || true
	rm -rf "$install_path"
	# OverlayFS leftovers on the same normalized path in the upper layer
	local overlay_path="/overlay/upper${install_path}"
	[ -d "$overlay_path" ] && rm -rf "$overlay_path" 2>/dev/null || true

	# 6. temp files + LuCI caches
	rm -f /tmp/openclaw-setup.* /tmp/openclaw-update.log /tmp/openclaw-plugin-upgrade.* /var/run/openclaw*.pid
	rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null

	# 7. remove the openclaw system user
	sed -i '/^openclaw:/d' /etc/passwd /etc/shadow /etc/group 2>/dev/null

	json_init
	json_add_string "status" "ok"
	json_add_string "message" "运行环境已卸载。已清理: Node.js 运行环境 ($install_path)、所有插件、临时文件、LuCI 缓存。"
	json_dump
}

